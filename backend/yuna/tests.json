{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "GET returns sessions list",
      "method": "GET",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "POST without audio returns 400",
      "method": "POST",
      "path": "/",
      "body": {"format": "webm"},
      "expectedStatus": 400,
      "bodyMatcher": "partial"
    },
    {
      "name": "GET doctors list",
      "method": "GET",
      "path": "/?resource=doctors",
      "expectedStatus": 200
    },
    {
      "name": "GET doctors rating",
      "method": "GET",
      "path": "/?resource=rating",
      "expectedStatus": 200
    },
    {
      "name": "GET stats",
      "method": "GET",
      "path": "/?resource=stats",
      "expectedStatus": 200
    },
    {
      "name": "POST doctor without name returns 400",
      "method": "POST",
      "path": "/?resource=doctors",
      "body": {"specialty": "Стоматолог"},
      "expectedStatus": 400,
      "bodyMatcher": "partial"
    },
    {
      "name": "Login with wrong credentials returns 401",
      "method": "POST",
      "path": "/?resource=login",
      "body": {"login": "nouser", "password": "wrongpass"},
      "expectedStatus": 401,
      "bodyMatcher": "partial"
    },
    {
      "name": "Login without data returns 400",
      "method": "POST",
      "path": "/?resource=login",
      "body": {},
      "expectedStatus": 400,
      "bodyMatcher": "partial"
    },
    {
      "name": "Analyze without session_id returns 400",
      "method": "POST",
      "path": "/?resource=analyze",
      "body": {},
      "expectedStatus": 400,
      "bodyMatcher": "partial"
    },
    {
      "name": "Me without token returns 401",
      "method": "GET",
      "path": "/?resource=me",
      "expectedStatus": 401,
      "bodyMatcher": "partial"
    }
  ]
}